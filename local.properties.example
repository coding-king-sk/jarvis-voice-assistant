# Isko copy karke "local.properties" naam se save karo (bina .example ke)
# Ye file git me kabhi commit nahi hoti — .gitignore me hai.

# Android SDK ka path (Android Studio khud bhar deta hai)
# Windows:  sdk.dir=C:\\Users\\TumharaNaam\\AppData\\Local\\Android\\Sdk
# Mac:      sdk.dir=/Users/tumharanaam/Library/Android/sdk
# Linux:    sdk.dir=/home/tumharanaam/Android/Sdk
sdk.dir=YAHAN_SDK_KA_PATH

# Gemini API key — https://aistudio.google.com/apikey se banao
# Ye key kabhi kisi ko mat bhejo aur na hi commit karo.
GEMINI_API_KEY=yahan_apni_key_paste_karo
